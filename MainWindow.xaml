<!-- Work Area Container -->
<Grid Background="#7F7F7F" Margin="4">
    <Grid x:Name="WorkspaceGrid" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Production Form Window -->
        <Border x:Name="ProductionFormWindow" Grid.Column="0" Margin="3" Background="#D4D0C8" BorderBrush="#FFFFFF" BorderThickness="1,1,2,2" Visibility="Collapsed">
            <!-- Production Form Design UI -->
        </Border>

        <!-- Right Container -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Card Design Window -->
            <Grid x:Name="CardDesignWindow" Grid.Row="0" Visibility="Collapsed">
                <!-- Card Front & Back Design UI -->
            </Grid>

            <!-- Report Design Window -->
            <Border x:Name="ReportDesignWindow" Grid.Row="1" Margin="3" Background="#D4D0C8" BorderBrush="#FFFFFF" BorderThickness="1,1,2,2" Visibility="Collapsed">
                <!-- Report Design UI -->
            </Border>
        </Grid>
    </Grid>
</Grid>
