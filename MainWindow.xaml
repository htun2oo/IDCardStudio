<Window x:Class="IDCardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#808080">

    <Window.Resources>
        <!-- MDI Sub-Window Header Gradient -->
        <LinearGradientBrush x:Key="ActiveTitleBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#005A9E" Offset="0.0" />
            <GradientStop Color="#A6C8E0" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SubTitleBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#A0B2C6" Offset="0.0" />
            <GradientStop Color="#CBD7E6" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="2,1">
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click" />
                <MenuItem Header="Open Project..." InputGestureText="Ctrl+O" />
                <MenuItem x:Name="SaveMenuItem" Header="Save" InputGestureText="Ctrl+S" IsEnabled="False" />
                <MenuItem x:Name="SaveAsMenuItem" Header="Save As..." IsEnabled="False" />
                <Separator />
                <MenuItem Header="Exit" Click="MenuItem_Exit_Click" />
            </MenuItem>

            <!-- Edit Menu -->
            <MenuItem x:Name="EditMenu" Header="_Edit" Visibility="Collapsed">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" />
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Cut" InputGestureText="Ctrl+X" />
                <MenuItem Header="Copy" InputGestureText="Ctrl+C" />
                <MenuItem Header="Paste" InputGestureText="Ctrl+V" />
                <MenuItem Header="Delete" InputGestureText="Del" />
            </MenuItem>

            <!-- View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True" />
                </MenuItem>
            </MenuItem>

            <!-- Insert Menu -->
            <MenuItem x:Name="InsertMenu" Header="_Insert" Visibility="Collapsed">
                <MenuItem Header="Text Field" />
                <MenuItem Header="Image Field" />
                <MenuItem Header="Barcode Field" />
                <MenuItem Header="Shape" />
            </MenuItem>

            <!-- Format Menu -->
            <MenuItem x:Name="FormatMenu" Header="F_ormat" Visibility="Collapsed">
                <MenuItem Header="Font..." />
                <MenuItem Header="Alignment" />
                <MenuItem Header="Bring to Front" />
                <MenuItem Header="Send to Back" />
            </MenuItem>

            <!-- Tools Menu -->
            <MenuItem x:Name="ToolsMenu" Header="_Tools">
                <MenuItem Header="Options..." />
            </MenuItem>

            <!-- Window Menu -->
            <MenuItem x:Name="WindowMenu" Header="_Window" Visibility="Collapsed">
                <MenuItem Header="Cascade" />
                <MenuItem Header="Tile Horizontally" />
                <MenuItem Header="Tile Vertically" />
                <Separator />
                <MenuItem Header="1 Production Form" IsChecked="True" />
                <MenuItem Header="2 Card" />
                <MenuItem Header="3 Card (back side)" />
                <MenuItem Header="4 Report" />
            </MenuItem>

            <!-- Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="Online Help..." InputGestureText="F1" />
                <Separator />
                <MenuItem Header="About..." />
            </MenuItem>
        </Menu>

        <!-- Main Toolbar Area -->
        <Border DockPanel.Dock="Top" Background="#E3E3E3" BorderBrush="#B5B5B5" BorderThickness="0,1,0,1" Padding="2">
            <ToolBarTray Background="Transparent" IsLocked="True">
                <ToolBar Background="Transparent" Band="0" BandIndex="0">
                    <Button ToolTip="New" Click="NewProject_Click"><TextBlock Text="📄" FontSize="14"/></Button>
                    <Button ToolTip="Open"><TextBlock Text="📂" FontSize="14"/></Button>
                    <Button ToolTip="Save"><TextBlock Text="💾" FontSize="14"/></Button>
                    <Button ToolTip="Print"><TextBlock Text="🖨️" FontSize="14"/></Button>
                    <Button ToolTip="Help"><TextBlock Text="❓" Foreground="Blue" FontWeight="Bold" FontSize="14"/></Button>
                    <Separator />
                    <Button ToolTip="Cut"><TextBlock Text="✂️" FontSize="14"/></Button>
                    <Button ToolTip="Copy"><TextBlock Text="📋" FontSize="14"/></Button>
                    <Button ToolTip="Paste"><TextBlock Text="📥" FontSize="14"/></Button>
                    <Separator />
                    <Button ToolTip="Undo"><TextBlock Text="↩️" FontSize="14"/></Button>
                    <Button ToolTip="Redo"><TextBlock Text="↪️" FontSize="14"/></Button>
                    <Separator />
                    <ComboBox Width="75" SelectedIndex="0" VerticalAlignment="Center" Margin="2,0">
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="200%"/>
                    </ComboBox>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#B5B5B5" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" Foreground="#333333"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Work Area Container -->
        <Grid Background="#7F7F7F" Margin="4">
            <Grid x:Name="WorkspaceGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Window: Production Form -->
                <Border Grid.Column="0" Margin="3" Background="#D4D0C8" BorderBrush="#FFFFFF" BorderThickness="1,1,2,2">
                    <DockPanel HorizontalAlignment="Stretch">
                        <!-- MDI Window TitleBar -->
                        <Border DockPanel.Dock="Top" Background="{StaticResource SubTitleBarBrush}" Padding="3,2">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📄" Margin="2,0,5,0" FontSize="10"/>
                                    <TextBlock Text="Production Form" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="-" Width="16" Height="14" Margin="1,0" FontSize="9" Background="#E0E0E0"/>
                                    <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8" Background="#E0E0E0"/>
                                    <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="9" Background="#E0E0E0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Window Client Area -->
                        <Border Background="White" Margin="2" BorderBrush="#808080" BorderThickness="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Canvas Background="White"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Right Side Windows Container -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Card Front & Card Back -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card (Front) Window (CR-80 Ratio) -->
                        <Border Grid.Column="0" Margin="3" Background="#D4D0C8" BorderBrush="#FFFFFF" BorderThickness="1,1,2,2">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{StaticResource SubTitleBarBrush}" Padding="3,2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎴" Margin="2,0,5,0" FontSize="10"/>
                                            <TextBlock Text="Card" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="-" Width="16" Height="14" Margin="1,0" FontSize="9" Background="#E0E0E0"/>
                                            <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8" Background="#E0E0E0"/>
                                            <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="9" Background="#E0E0E0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#D4D0C8" Margin="2" BorderBrush="#808080" BorderThickness="1">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D4D0C8">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                            <!-- CR-80 Standard Card Size Canvas (324px x 204px) -->
                                            <Border Width="324" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                                                </Border.Effect>
                                                <Canvas x:Name="CardFrontCanvas" Background="White"/>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Card (back side) Window (CR-80 Ratio) -->
                        <Border Grid.Column="1" Margin="3" Background="#D4D0C8" BorderBrush="#FFFFFF" BorderThickness="1,1,2,2">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{StaticResource SubTitleBarBrush}" Padding="3,2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎴" Margin="2,0,5,0" FontSize="10"/>
                                            <TextBlock Text="Card (back side)" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="-" Width="16" Height="14" Margin="1,0" FontSize="9" Background="#E0E0E0"/>
                                            <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8" Background="#E0E0E0"/>
                                            <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="9" Background="#E0E0E0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#D4D0C8" Margin="2" BorderBrush="#808080" BorderThickness="1">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D4D0C8">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                            <!-- CR-80 Standard Card Size Canvas (324px x 204px) -->
                                            <Border Width="324" Height="204" Background="White" BorderBrush="#000000" BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                                                </Border.Effect>
                                                <Canvas x:Name="CardBackCanvas" Background="White"/>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Report Window -->
                    <Border Grid.Row="1" Margin="3" Background="#D4D0C8" BorderBrush="#FFFFFF" BorderThickness="1,1,2,2">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource SubTitleBarBrush}" Padding="3,2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📊" Margin="2,0,5,0" FontSize="10"/>
                                        <TextBlock Text="Report" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="-" Width="16" Height="14" Margin="1,0" FontSize="9" Background="#E0E0E0"/>
                                        <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8" Background="#E0E0E0"/>
                                        <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="9" Background="#E0E0E0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="#D4D0C8" Margin="2" BorderBrush="#808080" BorderThickness="1">
                                <Grid Background="White" Margin="8"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
