<Window x:Class="IDCardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ID Card Studio Designer" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#808080">

    <DockPanel LastChildFill="True">

        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="2,1">
            <MenuItem Header="_File">
                <MenuItem Header="New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click" />
                <MenuItem Header="Open Project..." InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="Recent File" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Exit" Click="MenuItem_Exit_Click" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Properties Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Application Toolbar" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Tools Toolbar" IsCheckable="True" IsChecked="True" />
                    <Separator />
                    <MenuItem Header="Large Toolbar Buttons" IsCheckable="True" IsChecked="True" />
                    <MenuItem Header="Small Toolbar Buttons" IsCheckable="True" IsChecked="False" />
                </MenuItem>
                <MenuItem Header="Show Welcome on startup" IsCheckable="True" IsChecked="True" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Online Help..." InputGestureText="F1" />
                <Separator />
                <MenuItem Header="About..." />
            </MenuItem>
        </Menu>

        <!-- Main Toolbar Area -->
        <Border DockPanel.Dock="Top" Background="#E3E3E3" BorderBrush="#B5B5B5" BorderThickness="0,1,0,1" Padding="2">
            <ToolBarTray Background="Transparent" IsLocked="True">
                <ToolBar Background="Transparent" Band="0" BandIndex="0">
                    <Button ToolTip="New"><TextBlock Text="📄" FontSize="14"/></Button>
                    <Button ToolTip="Open"><TextBlock Text="📂" FontSize="14"/></Button>
                    <Button ToolTip="Save"><TextBlock Text="💾" FontSize="14"/></Button>
                    <Button ToolTip="Print"><TextBlock Text="🖨️" FontSize="14"/></Button>
                    <Button ToolTip="Help"><TextBlock Text="❓" Foreground="Blue" FontWeight="Bold" FontSize="14"/></Button>
                    <Separator />
                    <Button ToolTip="Cut"><TextBlock Text="✂️" FontSize="14"/></Button>
                    <Button ToolTip="Copy"><TextBlock Text="📋" FontSize="14"/></Button>
                    <Button ToolTip="Paste"><TextBlock Text="📥" FontSize="14"/></Button>
                    <Separator />
                    <Button ToolTip="Undo"><TextBlock Text="↩️" FontSize="14"/></Button>
                    <Button ToolTip="Redo"><TextBlock Text="↪️" FontSize="14"/></Button>
                    <Separator />
                    <ComboBox Width="75" SelectedIndex="0" VerticalAlignment="Center" Margin="2,0">
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="200%"/>
                    </ComboBox>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#B5B5B5" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" Foreground="#333333"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Canvas Work Area (MDI Container) -->
        <Grid Background="#808080" Padding="6">
            <Grid x:Name="WorkspaceGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Window: Production Form -->
                <Border Grid.Column="0" Margin="4" Background="#E0E0E0" BorderBrush="#707070" BorderThickness="1">
                    <DockPanel HorizontalAlignment="Stretch">
                        <Border DockPanel.Dock="Top" Background="#B4C6E7" Padding="4,2">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBlock Text="Production Form" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="_" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                    <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                    <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="White" Margin="2">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Canvas Background="White"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Right Side Windows Stack -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Card Front & Card Back -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card (Front) Window -->
                        <Border Grid.Column="0" Margin="2" Background="#E0E0E0" BorderBrush="#707070" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#B4C6E7" Padding="4,2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎴" Margin="0,0,5,0" FontSize="11"/>
                                            <TextBlock Text="Card" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="_" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                            <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                            <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#CCCCCC" Margin="2" BorderBrush="#A0A0A0" BorderThickness="1">
                                    <Grid Background="White" Margin="10"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Card (back side) Window -->
                        <Border Grid.Column="1" Margin="2" Background="#E0E0E0" BorderBrush="#707070" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#B4C6E7" Padding="4,2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎴" Margin="0,0,5,0" FontSize="11"/>
                                            <TextBlock Text="Card (back side)" FontWeight="Bold" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="_" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                            <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                            <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#CCCCCC" Margin="2" BorderBrush="#A0A0A0" BorderThickness="1">
                                    <Grid Background="White" Margin="10"/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Report Window -->
                    <Border Grid.Row="1" Margin="2" Background="#E0E0E0" BorderBrush="#707070" BorderThickness="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#B4C6E7" Padding="4,2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" Margin="0,0,5,0" FontSize="11"/>
                                        <TextBlock Text="Report" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="_" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                        <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                        <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="#CCCCCC" Margin="2" BorderBrush="#A0A0A0" BorderThickness="1">
                                <Grid Background="White" Margin="10"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
