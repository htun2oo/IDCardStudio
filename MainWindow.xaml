<Window x:Class="IDCardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ID Card Studio Designer" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#808080">

    <DockPanel LastChildFill="True">

        <!-- 1. Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="2,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="E_xit" Click="MenuItem_Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toolbar" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="_Status Bar" IsCheckable="True" IsChecked="True" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About ID Card Studio" />
            </MenuItem>
        </Menu>

        <!-- 2. Main Toolbar Area -->
        <Border DockPanel.Dock="Top" Background="#E3E3E3" BorderBrush="#B5B5B5" BorderThickness="0,1,0,1" Padding="2">
            <ToolBarTray Background="Transparent" IsLocked="True">
                <ToolBar Background="Transparent" Band="0" BandIndex="0">
                    <!-- File Operations -->
                    <Button ToolTip="New">
                        <TextBlock Text="📄" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Open">
                        <TextBlock Text="📂" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Save">
                        <TextBlock Text="💾" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Print">
                        <TextBlock Text="🖨️" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Help">
                        <TextBlock Text="❓" Foreground="Blue" FontWeight="Bold" FontSize="14"/>
                    </Button>
                    
                    <Separator />

                    <!-- Edit Operations -->
                    <Button ToolTip="Cut">
                        <TextBlock Text="✂️" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Copy">
                        <TextBlock Text="📋" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Paste">
                        <TextBlock Text="📥" FontSize="14"/>
                    </Button>
                    
                    <Separator />

                    <!-- Undo / Redo & Alignment Tools -->
                    <Button ToolTip="Undo">
                        <TextBlock Text="↩️" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Redo">
                        <TextBlock Text="↪️" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Align Left">
                        <TextBlock Text="⇤" FontSize="14" FontWeight="Bold"/>
                    </Button>
                    <Button ToolTip="Align Right">
                        <TextBlock Text="⇥" FontSize="14" FontWeight="Bold"/>
                    </Button>
                    <Button ToolTip="Center Horizontally">
                        <TextBlock Text="↔" FontSize="14" FontWeight="Bold"/>
                    </Button>

                    <Separator />

                    <!-- Designer Specific Tools -->
                    <Button ToolTip="Select Tool">
                        <TextBlock Text="↖" FontSize="14" FontWeight="Bold"/>
                    </Button>
                    <Button ToolTip="Add Text">
                        <TextBlock Text="T" FontSize="13" FontWeight="Bold" FontFamily="Times New Roman"/>
                    </Button>
                    <Button ToolTip="Add Rectangle">
                        <TextBlock Text="▭" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Add Image">
                        <TextBlock Text="🖼️" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Add Barcode">
                        <TextBlock Text="║▌" FontSize="12" FontWeight="Bold"/>
                    </Button>

                    <Separator />

                    <!-- Smart Card / ID Tools -->
                    <Button ToolTip="ID Smart Card Settings 1">
                        <TextBlock Text="💳" FontSize="14"/>
                    </Button>
                    <Button ToolTip="ID Smart Card Settings 2">
                        <TextBlock Text="📇" FontSize="14"/>
                    </Button>
                    <Button ToolTip="Chip Config">
                        <TextBlock Text="⚙️" FontSize="14"/>
                    </Button>

                    <Separator />

                    <!-- Zoom / View Control -->
                    <ComboBox Width="75" SelectedIndex="0" VerticalAlignment="Center" Margin="2,0">
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="200%"/>
                    </ComboBox>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- 3. Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#B5B5B5" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="For Help, press F1" FontSize="11" Foreground="#333333"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 4. Canvas Work Area (MDI Background) -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#808080">
            <Grid x:Name="DesignerCanvasContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Designer Canvas or Cards will be added here -->
            </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>
