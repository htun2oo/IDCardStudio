<Window x:Class="IDCardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="600" Width="800">
    
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="2">
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                <MenuItem Header="_Open Project..." InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                <Separator/>
                <MenuItem Header="Recent File" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>

            <!-- Menus hidden initially -->
            <MenuItem x:Name="EditMenu" Header="_Edit" Visibility="Collapsed"/>
            <MenuItem x:Name="InsertMenu" Header="_Insert" Visibility="Collapsed"/>
            <MenuItem x:Name="FormatMenu" Header="F_ormat" Visibility="Collapsed"/>
            <MenuItem x:Name="WindowMenu" Header="_Window" Visibility="Collapsed"/>

            <!-- View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Properties Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Application Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Tools Toolbar" IsCheckable="True" IsChecked="True"/>
                    <Separator/>
                    <MenuItem Header="Large Toolbar Buttons" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Small Toolbar Buttons" IsCheckable="True"/>
                </MenuItem>
                <MenuItem Header="Show Welcome on startup" IsCheckable="True" IsChecked="True"/>
            </MenuItem>

            <!-- Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="Online Help..." InputGestureText="F1" Click="OnlineHelp_Click"/>
                <Separator/>
                <MenuItem Header="About..." Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ကျန်ရှိသော UI Content များကို ဒီနေရာတွင် ထည့်ပါ -->
        <Grid x:Name="WorkspaceGrid">
            <!-- Canvas / Windows Elements -->
        </Grid>
        
    </DockPanel>
</Window>
