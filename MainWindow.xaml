<Window x:Class="IDCardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#D4D0C8">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="2">
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="NewProject_Click"/>
                <MenuItem Header="_Open Project..." Click="OpenProject_Click"/>
                <MenuItem Header="_Recent Projects">
                    <MenuItem Header="(No Recent Projects)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="SaveMenuItem" Header="_Save" IsEnabled="False"/>
                <MenuItem x:Name="SaveAsMenuItem" Header="Save _As..." IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>

            <!-- Edit Menu -->
            <MenuItem x:Name="EditMenu" Header="_Edit" Visibility="Collapsed"/>
            <MenuItem x:Name="ViewMenu" Header="_View"/>
            <MenuItem x:Name="InsertMenu" Header="_Insert" Visibility="Collapsed"/>
            <MenuItem x:Name="FormatMenu" Header="F_ormat" Visibility="Collapsed"/>
            <MenuItem x:Name="WindowMenu" Header="_Window" Visibility="Collapsed"/>
            <MenuItem Header="_Help"/>
        </Menu>

        <!-- Work Area Container -->
        <Grid Background="#7F7F7F">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Workspace Main Content -->
            <Grid Grid.Row="0" x:Name="WorkspaceGrid" Visibility="Collapsed" Margin="2">
                <Grid.ColumnDefinitions>
                    <!-- Left Side: Production Form -->
                    <ColumnDefinition x:Name="ProductionColumn" Width="1.2*" />
                    <!-- Right Side: Cards & Reports Container -->
                    <ColumnDefinition x:Name="RightColumn" Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Production Form Window -->
                <Border x:Name="ProductionFormWindow" Grid.Column="0" Margin="2" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Visibility="Collapsed">
                    <DockPanel>
                        <!-- Title Bar -->
                        <Border DockPanel.Dock="Top" Background="#000080" Height="22" Padding="4,0,2,0">
                            <Grid>
                                <TextBlock Text="Production Form" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnMinProduction" Content="_" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-4,0,0" Click="btnMinProduction_Click"/>
                                    <Button x:Name="btnMaxProduction" Content="□" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-2,0,0" Click="btnMaxProduction_Click"/>
                                    <Button x:Name="btnCloseProduction" Content="X" Width="16" Height="16" Margin="1" FontSize="9" FontWeight="Bold" Click="btnCloseProduction_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Content -->
                        <Grid Background="White" Margin="4"/>
                    </DockPanel>
                </Border>

                <!-- Right Side Area (Card Windows + Report Window) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Card Windows Area (Front & Back Side-by-Side) -->
                    <Grid Grid.Row="0" x:Name="CardDesignWindow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card Front Window -->
                        <Border x:Name="CardFrontWindow" Grid.Column="0" Margin="2" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#000080" Height="22" Padding="4,0,2,0">
                                    <Grid>
                                        <TextBlock Text="Card" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="btnMinCardFront" Content="_" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-4,0,0" Click="btnMinCardFront_Click"/>
                                            <Button x:Name="btnMaxCardFront" Content="□" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-2,0,0" Click="btnMaxCardFront_Click"/>
                                            <Button x:Name="btnCloseCardFront" Content="X" Width="16" Height="16" Margin="1" FontSize="9" FontWeight="Bold" Click="btnCloseCardFront_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#A0A0A0" Padding="10">
                                    <Border x:Name="CardFrontCanvas" Width="220" Height="140" Background="White" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="[ Card Front ]" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Card Back Window -->
                        <Border x:Name="CardBackWindow" Grid.Column="1" Margin="2" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#000080" Height="22" Padding="4,0,2,0">
                                    <Grid>
                                        <TextBlock Text="Card (back side)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="btnMinCardBack" Content="_" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-4,0,0" Click="btnMinCardBack_Click"/>
                                            <Button x:Name="btnMaxCardBack" Content="□" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-2,0,0" Click="btnMaxCardBack_Click"/>
                                            <Button x:Name="btnCloseCardBack" Content="X" Width="16" Height="16" Margin="1" FontSize="9" FontWeight="Bold" Click="btnCloseCardBack_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#A0A0A0" Padding="10">
                                    <Border x:Name="CardBackCanvas" Width="220" Height="140" Background="White" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="[ Card Back ]" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Report Design Window -->
                    <Border Grid.Row="1" x:Name="ReportDesignWindow" Margin="2" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Visibility="Collapsed">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#000080" Height="22" Padding="4,0,2,0">
                                <Grid>
                                    <TextBlock Text="Report Design" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="btnMinReport" Content="_" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-4,0,0" Click="btnMinReport_Click"/>
                                        <Button x:Name="btnMaxReport" Content="□" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-2,0,0" Click="btnMaxReport_Click"/>
                                        <Button x:Name="btnCloseReport" Content="X" Width="16" Height="16" Margin="1" FontSize="9" FontWeight="Bold" Click="btnCloseReport_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Background="White" Margin="4"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Minimized Windows Dock Container -->
            <StackPanel Grid.Row="1" x:Name="MinimizedBar" Orientation="Horizontal" VerticalAlignment="Bottom" Height="26" Margin="2,0,2,2">
                
                <!-- Minimized Production Form -->
                <Border x:Name="minProdWindow" Width="160" Height="24" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0" Visibility="Collapsed">
                    <Grid Margin="2,0">
                        <TextBlock Text="Production Form" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="❐" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreProduction_Click"/>
                            <Button Content="□" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreProduction_Click"/>
                            <Button Content="X" Width="16" Height="16" FontSize="8" FontWeight="Bold" Margin="1" Click="btnCloseProduction_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Minimized Card Front -->
                <Border x:Name="minCardFrontWindow" Width="160" Height="24" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0" Visibility="Collapsed">
                    <Grid Margin="2,0">
                        <TextBlock Text="Card" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="❐" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreCardFront_Click"/>
                            <Button Content="□" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreCardFront_Click"/>
                            <Button Content="X" Width="16" Height="16" FontSize="8" FontWeight="Bold" Margin="1" Click="btnCloseCardFront_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Minimized Card Back -->
                <Border x:Name="minCardBackWindow" Width="160" Height="24" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0" Visibility="Collapsed">
                    <Grid Margin="2,0">
                        <TextBlock Text="Card (back side)" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="❐" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreCardBack_Click"/>
                            <Button Content="□" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreCardBack_Click"/>
                            <Button Content="X" Width="16" Height="16" FontSize="8" FontWeight="Bold" Margin="1" Click="btnCloseCardBack_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Minimized Report Design -->
                <Border x:Name="minReportWindow" Width="160" Height="24" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0" Visibility="Collapsed">
                    <Grid Margin="2,0">
                        <TextBlock Text="Report Design" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="❐" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreReport_Click"/>
                            <Button Content="□" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreReport_Click"/>
                            <Button Content="X" Width="16" Height="16" FontSize="8" FontWeight="Bold" Margin="1" Click="btnCloseReport_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
