<Window x:Class="IDCardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#D4D0C8">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="2">
            
            <!-- 1. File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                <MenuItem Header="_Open Project..." InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                <MenuItem Header="_Close Project" Click="CloseProject_Click"/>
                <Separator/>
                <MenuItem Header="_Save Project" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                <MenuItem Header="Save Project _As..." Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="Project _Properties..." InputGestureText="F7"/>
                <Separator/>
                <MenuItem Header="_Print Sample Card..." InputGestureText="Ctrl+P"/>
                <MenuItem Header="Preview Sample _Report..." IsEnabled="False"/>
                <MenuItem Header="Report Page Set_up..." IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Delete Project"/>
                <Separator/>
                <MenuItem Header="1 C:\Users\...\Sample\Sample.iwp" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>

            <!-- 2. Edit Menu -->
            <MenuItem x:Name="EditMenu" Header="_Edit" Visibility="Collapsed">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" IsEnabled="False"/>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Cu_t Fields" InputGestureText="Ctrl+X" IsEnabled="False"/>
                <MenuItem Header="_Copy Fields" InputGestureText="Ctrl+C" IsEnabled="False"/>
                <MenuItem Header="_Paste Fields" InputGestureText="Ctrl+V" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Select _Fields..." IsEnabled="False"/>
                <MenuItem Header="Select _All Fields" InputGestureText="Ctrl+A" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Field _Properties..." InputGestureText="Ctrl+F" IsEnabled="False"/>
                <MenuItem Header="_Multi-field Text Properties..."/>
                <MenuItem Header="Multi-field _Prompt Properties..."/>
                <MenuItem Header="P_roduction Form Properties..." InputGestureText="F6"/>
                <Separator/>
                <MenuItem Header="Field Tab Or_der" InputGestureText="Ctrl+B" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Delete Selected Fi_elds" InputGestureText="Del" IsEnabled="False"/>
                <MenuItem Header="Delete Production Form"/>
            </MenuItem>

            <!-- 3. View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="_Toolbars">
                    <MenuItem Header="Project Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Edit Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="View Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Zoom Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Properties Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Application Toolbar" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Tools Toolbar" IsCheckable="True" IsChecked="True"/>
                    <Separator/>
                    <MenuItem Header="Large Toolbar Buttons" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Small Toolbar Buttons" IsCheckable="True"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Field _Names" InputGestureText="Ctrl+H"/>
                <MenuItem Header="_Sample Data" InputGestureText="Ctrl+M" IsCheckable="True" IsChecked="True"/>
                <Separator/>
                <MenuItem Header="_Card..."/>
                <MenuItem Header="_Report..."/>
                <MenuItem Header="_Production Form"/>
                <MenuItem Header="Field Connector"/>
                <Separator/>
                <MenuItem Header="Front of Selected Card" IsEnabled="False"/>
                <MenuItem Header="Back of Selected Card" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Ruler for Selected Card Side" IsCheckable="True" IsChecked="True" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Show Welcome on startup" IsCheckable="True" IsChecked="True"/>
            </MenuItem>

            <!-- 4. Insert Menu -->
            <MenuItem x:Name="InsertMenu" Header="_Insert" Visibility="Collapsed">
                <MenuItem Header="_Text Field" InputGestureText="Ctrl+T"/>
                <MenuItem Header="_Photo Field" InputGestureText="Ctrl+J"/>
                <MenuItem Header="_Date Field" InputGestureText="Ctrl+D"/>
                <MenuItem Header="_Signature Field" InputGestureText="Ctrl+I"/>
                <Separator/>
                <MenuItem Header="_List Field" InputGestureText="Ctrl+L"/>
                <MenuItem Header="_Composite Field"/>
                <MenuItem Header="P_rint Count Field"/>
                <MenuItem Header="_Auto Sequence Field"/>
                <MenuItem Header="C_heck Box Field"/>
                <MenuItem Header="Bina_ry Field"/>
                <MenuItem Header="_Event Button"/>
                <Separator/>
                <MenuItem Header="Bar Code Field" IsEnabled="False"/>
                <MenuItem Header="Magnetic Stripe Field" IsEnabled="False"/>
                <MenuItem Header="Smart Card Field" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Static Te_xt Field" InputGestureText="Ctrl+E"/>
                <MenuItem Header="Static _Graphic Field" InputGestureText="Ctrl+G"/>
                <MenuItem Header="Non-Printable Area" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Card">
                    <MenuItem Header="New card"/>
                    <MenuItem Header="From Template..."/>
                </MenuItem>
                <MenuItem Header="Production Form" IsEnabled="False"/>
                <MenuItem Header="_Report">
                    <MenuItem Header="New report"/>
                    <MenuItem Header="From Template..."/>
                </MenuItem>
            </MenuItem>

            <!-- 5. Format Menu -->
            <MenuItem x:Name="FormatMenu" Header="F_ormat" Visibility="Collapsed">
                <MenuItem Header="_Align Fields">
                    <MenuItem Header="Left" InputGestureText="Ctrl+Left Arrow" IsEnabled="False"/>
                    <MenuItem Header="Right" InputGestureText="Ctrl+Right Arrow" IsEnabled="False"/>
                    <MenuItem Header="Top" InputGestureText="Ctrl+Up Arrow" IsEnabled="False"/>
                    <MenuItem Header="Bottom" InputGestureText="Ctrl+Down Arrow" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="_Center Field(s)">
                    <MenuItem Header="Horizontal" InputGestureText="Ctrl+F9" IsEnabled="False"/>
                    <MenuItem Header="Vertical" InputGestureText="Ctrl+Shift+F9" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="_Space Fields Evenly">
                    <MenuItem Header="Across" InputGestureText="Alt+Right Arrow" IsEnabled="False"/>
                    <MenuItem Header="Down" InputGestureText="Alt+Down Arrow" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="_Make Fields Same Size">
                    <MenuItem Header="Width" InputGestureText="Ctrl+F7" IsEnabled="False"/>
                    <MenuItem Header="Height" InputGestureText="Ctrl+Shift+F7" IsEnabled="False"/>
                    <MenuItem Header="Both" InputGestureText="Alt+F7" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Bring Field to Front" IsEnabled="False"/>
                <MenuItem Header="Bring Field Forward" IsEnabled="False"/>
                <MenuItem Header="Send Field to Back" IsEnabled="False"/>
                <MenuItem Header="Send Field Backward" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Rotate Field on Production Form" InputGestureText="Ctrl+R" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Set Static Graphic to Original Size" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Keep Fields Proportional when Dragging Corner"/>
                <MenuItem Header="Do Not Keep Fields Proportional when Dragging Corner" IsCheckable="True" IsChecked="True"/>
                <Separator/>
                <MenuItem Header="Orientation of Selected Card Side">
                    <MenuItem Header="Landscape" IsCheckable="True" IsChecked="True"/>
                    <MenuItem Header="Portrait" IsCheckable="True"/>
                </MenuItem>
            </MenuItem>

            <!-- 6. Tools Menu -->
            <MenuItem x:Name="ToolsMenu" Header="_Tools" Visibility="Collapsed">
                <MenuItem Header="Production Options..."/>
                <MenuItem Header="User Options..."/>
            </MenuItem>

            <!-- 7. Window Menu -->
            <MenuItem x:Name="WindowMenu" Header="_Window" Visibility="Collapsed">
                <MenuItem Header="Cascade"/>
                <MenuItem Header="Tile Horizontally"/>
                <MenuItem Header="Tile Vertically"/>
            </MenuItem>

            <!-- 8. Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="Online Help..." InputGestureText="F1" Click="OnlineHelp_Click"/>
                <Separator/>
                <MenuItem Header="About..." Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Work Area Container -->
        <Grid Background="#7F7F7F">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Workspace Main Content -->
            <Grid Grid.Row="0" x:Name="WorkspaceGrid" Visibility="Collapsed" Margin="2">
                <Grid.ColumnDefinitions>
                    <!-- Left Side: Production Form -->
                    <ColumnDefinition x:Name="ProductionColumn" Width="1.2*" />
                    <!-- Right Side: Cards & Reports Container -->
                    <ColumnDefinition x:Name="RightColumn" Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Production Form Window -->
                <Border x:Name="ProductionFormWindow" Grid.Column="0" Margin="2" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Visibility="Collapsed">
                    <DockPanel>
                        <!-- Title Bar -->
                        <Border DockPanel.Dock="Top" Background="#000080" Height="22" Padding="4,0,2,0">
                            <Grid>
                                <TextBlock Text="Production Form" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnMinProduction" Content="_" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-4,0,0" Click="btnMinProduction_Click"/>
                                    <Button x:Name="btnMaxProduction" Content="□" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-2,0,0" Click="btnMaxProduction_Click"/>
                                    <Button x:Name="btnCloseProduction" Content="X" Width="16" Height="16" Margin="1" FontSize="9" FontWeight="Bold" Click="btnCloseProduction_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Content -->
                        <Grid Background="White" Margin="4"/>
                    </DockPanel>
                </Border>

                <!-- Right Side Area (Card Windows + Report Window) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Card Windows Area (Front & Back Side-by-Side) -->
                    <Grid Grid.Row="0" x:Name="CardDesignWindow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card Front Window -->
                        <Border x:Name="CardFrontWindow" Grid.Column="0" Margin="2" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#000080" Height="22" Padding="4,0,2,0">
                                    <Grid>
                                        <TextBlock Text="Card" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="btnMinCardFront" Content="_" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-4,0,0" Click="btnMinCardFront_Click"/>
                                            <Button x:Name="btnMaxCardFront" Content="□" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-2,0,0" Click="btnMaxCardFront_Click"/>
                                            <Button x:Name="btnCloseCardFront" Content="X" Width="16" Height="16" Margin="1" FontSize="9" FontWeight="Bold" Click="btnCloseCardFront_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#A0A0A0" Padding="10">
                                    <Border x:Name="CardFrontCanvas" Width="238" Height="150" Background="White" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="[ Card Front - CR80 ]" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- Card Back Window -->
                        <Border x:Name="CardBackWindow" Grid.Column="1" Margin="2" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#000080" Height="22" Padding="4,0,2,0">
                                    <Grid>
                                        <TextBlock Text="Card (back side)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="btnMinCardBack" Content="_" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-4,0,0" Click="btnMinCardBack_Click"/>
                                            <Button x:Name="btnMaxCardBack" Content="□" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-2,0,0" Click="btnMaxCardBack_Click"/>
                                            <Button x:Name="btnCloseCardBack" Content="X" Width="16" Height="16" Margin="1" FontSize="9" FontWeight="Bold" Click="btnCloseCardBack_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="#A0A0A0" Padding="10">
                                    <Border x:Name="CardBackCanvas" Width="238" Height="150" Background="White" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="[ Card Back - CR80 ]" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Report Design Window -->
                    <Border Grid.Row="1" x:Name="ReportDesignWindow" Margin="2" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Visibility="Collapsed">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#000080" Height="22" Padding="4,0,2,0">
                                <Grid>
                                    <TextBlock Text="Report Design" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="btnMinReport" Content="_" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-4,0,0" Click="btnMinReport_Click"/>
                                        <Button x:Name="btnMaxReport" Content="□" Width="16" Height="16" Margin="1" FontSize="9" Padding="0,-2,0,0" Click="btnMaxReport_Click"/>
                                        <Button x:Name="btnCloseReport" Content="X" Width="16" Height="16" Margin="1" FontSize="9" FontWeight="Bold" Click="btnCloseReport_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Background="White" Margin="4"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Minimized Windows Dock Container -->
            <StackPanel Grid.Row="1" x:Name="MinimizedBar" Orientation="Horizontal" VerticalAlignment="Bottom" Height="26" Margin="2,0,2,2">
                
                <!-- Minimized Production Form -->
                <Border x:Name="minProdWindow" Width="160" Height="24" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0" Visibility="Collapsed">
                    <Grid Margin="2,0">
                        <TextBlock Text="Production Form" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="❐" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreProduction_Click"/>
                            <Button Content="□" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreProduction_Click"/>
                            <Button Content="X" Width="16" Height="16" FontSize="8" FontWeight="Bold" Margin="1" Click="btnCloseProduction_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Minimized Card Front -->
                <Border x:Name="minCardFrontWindow" Width="160" Height="24" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0" Visibility="Collapsed">
                    <Grid Margin="2,0">
                        <TextBlock Text="Card" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="❐" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreCardFront_Click"/>
                            <Button Content="□" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreCardFront_Click"/>
                            <Button Content="X" Width="16" Height="16" FontSize="8" FontWeight="Bold" Margin="1" Click="btnCloseCardFront_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Minimized Card Back -->
                <Border x:Name="minCardBackWindow" Width="160" Height="24" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0" Visibility="Collapsed">
                    <Grid Margin="2,0">
                        <TextBlock Text="Card (back side)" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="❐" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreCardBack_Click"/>
                            <Button Content="□" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreCardBack_Click"/>
                            <Button Content="X" Width="16" Height="16" FontSize="8" FontWeight="Bold" Margin="1" Click="btnCloseCardBack_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Minimized Report Design -->
                <Border x:Name="minReportWindow" Width="160" Height="24" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0" Visibility="Collapsed">
                    <Grid Margin="2,0">
                        <TextBlock Text="Report Design" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="❐" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreReport_Click"/>
                            <Button Content="□" Width="16" Height="16" FontSize="8" Margin="1" Click="btnRestoreReport_Click"/>
                            <Button Content="X" Width="16" Height="16" FontSize="8" FontWeight="Bold" Margin="1" Click="btnCloseReport_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
