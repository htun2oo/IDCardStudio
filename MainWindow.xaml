<Window x:Class="IDCardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#808080">

    <DockPanel>
        <!-- Dynamic Menu Bar -->
        <Menu DockPanel.Dock="Top" Height="24" Background="#F0F0F0">
            <!-- File Menu (Always Visible) -->
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="NewProject_Click"/>
                <MenuItem Header="_Open Project..." Click="OpenProject_Click"/>
                <MenuItem Header="_Close Project" Click="CloseProject_Click"/>
                <Separator/>
                <MenuItem Header="_Save Project" Click="SaveProject_Click"/>
                <MenuItem Header="Save Project _As..." Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>

            <!-- Edit Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="menuEdit" Header="_Edit" Visibility="Collapsed"/>

            <!-- View Menu (Always Visible) -->
            <MenuItem Header="_View"/>

            <!-- Insert Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="menuInsert" Header="_Insert" Visibility="Collapsed"/>

            <!-- Format Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="menuFormat" Header="_Format" Visibility="Collapsed"/>

            <!-- Tools Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="menuTools" Header="_Tools" Visibility="Collapsed"/>

            <!-- Window Menu (Project ဖွင့်မှ ပေါ်မည်) -->
            <MenuItem x:Name="menuWindow" Header="_Window" Visibility="Collapsed"/>

            <!-- Help Menu (Always Visible) -->
            <MenuItem Header="_Help"/>
        </Menu>

        <!-- Main Workspace Area -->
        <Grid x:Name="WorkspaceGrid" Background="#808080" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colLeft" Width="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition x:Name="colRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel (Card Front & Card Back Windows) -->
            <Grid Grid.Column="0" x:Name="pnlCardContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Card Window -->
                <Border Grid.Row="0" Margin="0,0,0,4" BorderBrush="#707070" BorderThickness="1" Background="#ECECEC">
                    <DockPanel>
                        <!-- Title Bar -->
                        <Grid DockPanel.Dock="Top" Background="#B0C4DE" Height="22">
                            <TextBlock Text="Card" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Normal" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                <Button Content="—" Width="16" Height="15" FontSize="8" Margin="1,0"/>
                                <Button Content="☐" Width="16" Height="15" FontSize="8" Margin="1,0"/>
                                <Button Content="✕" Width="16" Height="15" FontSize="8" Margin="1,0" Foreground="Red"/>
                            </StackPanel>
                        </Grid>
                        <!-- Card View Area -->
                        <Border Background="White" Margin="4" BorderBrush="#A0A0A0" BorderThickness="1">
                            <Canvas x:Name="cvsCardFront" Background="White"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 2. Card (back side) Window -->
                <Border Grid.Row="1" Margin="0,4,0,0" BorderBrush="#707070" BorderThickness="1" Background="#ECECEC">
                    <DockPanel>
                        <!-- Title Bar -->
                        <Grid DockPanel.Dock="Top" Background="#B0C4DE" Height="22">
                            <TextBlock Text="Card (back side)" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Normal" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                <Button Content="—" Width="16" Height="15" FontSize="8" Margin="1,0"/>
                                <Button Content="☐" Width="16" Height="15" FontSize="8" Margin="1,0"/>
                                <Button Content="✕" Width="16" Height="15" FontSize="8" Margin="1,0" Foreground="Red"/>
                            </StackPanel>
                        </Grid>
                        <!-- Card Back View Area -->
                        <Border Background="White" Margin="4" BorderBrush="#A0A0A0" BorderThickness="1">
                            <Canvas x:Name="cvsCardBack" Background="White"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right Panel (Production Form Window) -->
            <Border Grid.Column="2" x:Name="pnlProductionForm" Visibility="Collapsed" BorderBrush="#707070" BorderThickness="1" Background="White">
                <DockPanel>
                    <!-- Title Bar -->
                    <Grid DockPanel.Dock="Top" Background="#B0C4DE" Height="22">
                        <TextBlock Text="Production Form" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Normal" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <Button Content="—" Width="16" Height="15" FontSize="8" Margin="1,0"/>
                            <Button Content="☐" Width="16" Height="15" FontSize="8" Margin="1,0"/>
                            <Button Content="✕" Width="16" Height="15" FontSize="8" Margin="1,0" Foreground="Red"/>
                        </StackPanel>
                    </Grid>
                    <!-- Form Area -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="White">
                        <Canvas x:Name="cvsProductionForm" Background="White"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
