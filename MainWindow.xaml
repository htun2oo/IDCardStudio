<Window x:Class="IDCardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datacard ID Works Enterprise Designer" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#808080">

    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Height="24" Background="#F0F0F0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="NewProject_Click"/>
                <MenuItem Header="_Open Project..." Click="OpenProject_Click"/>
                <MenuItem Header="_Close Project" Click="CloseProject_Click"/>
                <Separator/>
                <MenuItem Header="_Save Project" Click="SaveProject_Click"/>
                <MenuItem Header="Save Project _As..." Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_View"/>
            <MenuItem Header="_Insert"/>
            <MenuItem Header="_Format"/>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Window"/>
            <MenuItem Header="_Help"/>
        </Menu>

        <!-- Main Workspace Area -->
        <Grid x:Name="WorkspaceGrid" Background="#808080" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colLeft" Width="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="colRight" Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel (Card Front & Card Back) -->
            <Grid Grid.Column="0" x:Name="pnlCardContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Card Front Window -->
                <Border Grid.Row="0" Margin="0,0,0,5" BorderBrush="#005A9E" BorderThickness="1" Background="#ECECEC" CornerRadius="2">
                    <DockPanel>
                        <!-- Title Bar -->
                        <Grid DockPanel.Dock="Top" Background="#B0C4DE" Height="24">
                            <TextBlock Text="Card" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                <Button Content="—" Width="18" Height="16" FontSize="9" Margin="1,0"/>
                                <Button Content="☐" Width="18" Height="16" FontSize="9" Margin="1,0"/>
                                <Button Content="✕" Width="18" Height="16" FontSize="9" Margin="1,0" Foreground="Red"/>
                            </StackPanel>
                        </Grid>
                        <!-- Canvas / Card Canvas Content -->
                        <Border Background="White" Margin="5" BorderBrush="#A0A0A0" BorderThickness="1">
                            <Canvas x:Name="cvsCardFront" Background="White"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- 2. Card Back Side Window -->
                <Border Grid.Row="1" Margin="0,5,0,0" BorderBrush="#005A9E" BorderThickness="1" Background="#ECECEC" CornerRadius="2">
                    <DockPanel>
                        <!-- Title Bar -->
                        <Grid DockPanel.Dock="Top" Background="#B0C4DE" Height="24">
                            <TextBlock Text="Card (back side)" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                <Button Content="—" Width="18" Height="16" FontSize="9" Margin="1,0"/>
                                <Button Content="☐" Width="18" Height="16" FontSize="9" Margin="1,0"/>
                                <Button Content="✕" Width="18" Height="16" FontSize="9" Margin="1,0" Foreground="Red"/>
                            </StackPanel>
                        </Grid>
                        <!-- Canvas / Card Canvas Content -->
                        <Border Background="White" Margin="5" BorderBrush="#A0A0A0" BorderThickness="1">
                            <Canvas x:Name="cvsCardBack" Background="White"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right Panel (Production Form Window) -->
            <Border Grid.Column="2" x:Name="pnlProductionForm" Visibility="Collapsed" BorderBrush="#005A9E" BorderThickness="1" Background="White" CornerRadius="2">
                <DockPanel>
                    <!-- Title Bar -->
                    <Grid DockPanel.Dock="Top" Background="#B0C4DE" Height="24">
                        <TextBlock Text="Production Form" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="SemiBold" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <Button Content="—" Width="18" Height="16" FontSize="9" Margin="1,0"/>
                            <Button Content="☐" Width="18" Height="16" FontSize="9" Margin="1,0"/>
                            <Button Content="✕" Width="18" Height="16" FontSize="9" Margin="1,0" Foreground="Red"/>
                        </StackPanel>
                    </Grid>
                    <!-- Form Area -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="White">
                        <Canvas x:Name="cvsProductionForm" Background="White"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
