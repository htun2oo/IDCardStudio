<!-- Canvas Work Area (MDI Container) -->
<Grid Background="#808080" Padding="6">
    <Grid x:Name="WorkspaceGrid" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Window: Production Form -->
        <Border Grid.Column="0" Margin="4" Background="#E0E0E0" BorderBrush="#707070" BorderThickness="1">
            <DockPanelHorizontalAlignment="Stretch">
                <!-- Title Bar -->
                <Border DockPanel.Dock="Top" Background="#B4C6E7" Padding="4,2">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,5,0" FontSize="11"/>
                            <TextBlock Text="Production Form" FontWeight="Bold" FontSize="11" Foreground="#000000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="_" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                            <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                            <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Form Content Area -->
                <Border Background="White" Margin="2">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas Background="White"/>
                    </ScrollViewer>
                </Border>
            </DockPanelHorizontalAlignment>
        </Border>

        <!-- Right Side Stack (Card Front, Card Back, Report) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Row: Card Front & Card Back -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card (Front) Window -->
                <Border Grid.Column="0" Margin="2" Background="#E0E0E0" BorderBrush="#707070" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#B4C6E7" Padding="4,2">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎴" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBlock Text="Card" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="_" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                    <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                    <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Designer Canvas with Ruler -->
                        <Border Background="#CCCCCC" Margin="2" BorderBrush="#A0A0A0" BorderThickness="1">
                            <Grid Background="White" Margin="10">
                                <!-- Card Canvas Area -->
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Card (back side) Window -->
                <Border Grid.Column="1" Margin="2" Background="#E0E0E0" BorderBrush="#707070" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#B4C6E7" Padding="4,2">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎴" Margin="0,0,5,0" FontSize="11"/>
                                    <TextBlock Text="Card (back side)" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="_" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                    <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                    <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#CCCCCC" Margin="2" BorderBrush="#A0A0A0" BorderThickness="1">
                            <Grid Background="White" Margin="10">
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Bottom Row: Report Window -->
            <Border Grid.Row="1" Margin="2" Background="#E0E0E0" BorderBrush="#707070" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#B4C6E7" Padding="4,2">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,5,0" FontSize="11"/>
                                <TextBlock Text="Report" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="_" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                <Button Content="□" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                                <Button Content="✕" Width="16" Height="14" Margin="1,0" FontSize="8"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="#CCCCCC" Margin="2" BorderBrush="#A0A0A0" BorderThickness="1">
                        <Grid Background="White" Margin="10">
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Grid>
