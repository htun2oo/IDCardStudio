<Window x:Class="IDCardStudio.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project" 
        Height="310" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>

        <!-- Project Name Input -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="Project Name:" Margin="0,0,0,5" FontSize="12"/>
            <TextBox x:Name="txtProjectName" Height="24" VerticalContentAlignment="Center" Padding="3,0"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <Button x:Name="btnOK" Content="OK" Height="26" Margin="0,18,0,8" Click="btnOK_Click" IsDefault="True"/>
            <Button x:Name="btnCancel" Content="Cancel" Height="26" Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>

        <!-- Initial Components Group -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Initial Components" Margin="0,0,10,0" Padding="10,8">
            <StackPanel>
                <CheckBox x:Name="chkProductionForm" Content="Production Form Design" IsChecked="True" Margin="0,2"/>
                <CheckBox x:Name="chkCardDesign" Content="Card Design" IsChecked="True" Margin="0,4,0,2"/>

                <!-- Orientation Selection -->
                <StackPanel Margin="30,2,0,5">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Border Width="16" Height="11" BorderBrush="#333333" BorderThickness="1" Background="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rdoLandscape" Content="Landscape" IsChecked="True" GroupName="CardOrientation" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Border Width="11" Height="16" BorderBrush="#333333" BorderThickness="1" Background="White" Margin="2,0,11,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rdoPortrait" Content="Portrait" GroupName="CardOrientation" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox x:Name="chkMultiCardDesign" Content="Allow for more than one card design&#10;(data-driven card production)" Margin="0,6,0,0" Foreground="#333333" FontSize="11"/>
                </StackPanel>

                <CheckBox x:Name="chkReportDesign" Content="Report Design" IsChecked="False" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
