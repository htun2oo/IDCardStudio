<Window x:Class="IDCardStudio.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project" Height="260" Width="380"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#F0F0F0"
        FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <Grid.ColumnDefinition Width="*"/>
            <Grid.ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Project Name Section -->
        <TextBlock Text="Project Name:" Grid.Row="0" Grid.Column="0" Margin="0,0,0,3"/>
        <TextBox x:Name="txtProjectName" Grid.Row="1" Grid.Column="0" Height="22" VerticalContentAlignment="Center" Margin="0,0,10,10"/>

        <!-- OK / Cancel Buttons -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" VerticalAlignment="Top">
            <Button Content="OK" Width="75" Height="23" Margin="0,18,0,6" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="75" Height="23" IsCancel="True"/>
        </StackPanel>

        <!-- Initial Components GroupBox -->
        <GroupBox Header="Initial Components" Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" Padding="5">
            <StackPanel Margin="5,2,0,0">
                <CheckBox x:Name="chkProductionForm" Content="Production Form Design" IsChecked="True" Margin="0,0,0,4"/>
                <CheckBox x:Name="chkCardDesign" Content="Card Design" IsChecked="True" Margin="0,0,0,4" Checked="chkCardDesign_Changed" Unchecked="chkCardDesign_Changed"/>

                <!-- Orientation & Options Sub Panel -->
                <StackPanel x:Name="pnlCardOptions" Margin="20,0,0,4">
                    <!-- Landscape Option -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="18" Height="12" BorderBrush="Black" BorderThickness="1" Background="White" Margin="0,0,10,0"/>
                        <RadioButton x:Name="rbLandscape" Content="Landscape" IsChecked="True" GroupName="CardOrientation"/>
                    </StackPanel>

                    <!-- Portrait Option -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="12" Height="18" BorderBrush="Black" BorderThickness="1" Background="White" Margin="3,0,13,0"/>
                        <RadioButton x:Name="rbPortrait" Content="Portrait" GroupName="CardOrientation"/>
                    </StackPanel>

                    <!-- Data-driven Card Production Checkbox -->
                    <CheckBox x:Name="chkMultiCard" Margin="0,2,0,0">
                        <TextBlock TextWrapping="Wrap" Width="180" Text="Allow for more than one card design (data-driven card production)"/>
                    </CheckBox>
                </StackPanel>

                <!-- Report Design Option -->
                <CheckBox x:Name="chkReportDesign" Content="Report Design" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
