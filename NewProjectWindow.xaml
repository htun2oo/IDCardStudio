<Window x:Class="IDCardStudio.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project" 
        Height="295" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="85" />
        </Grid.ColumnDefinitions>

        <!-- Left Controls Area -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <!-- Project Name Section -->
            <TextBlock Text="Project Name:" Margin="0,0,0,4" FontSize="12"/>
            <TextBox x:Name="ProjectNameTextBox" Height="23" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <!-- Initial Components GroupBox -->
            <GroupBox Header="Initial Components" Padding="8,6,8,8">
                <StackPanel>
                    <!-- Production Form Design Checkbox -->
                    <CheckBox Content="Production Form Design" IsChecked="True" Margin="0,2,0,4"/>

                    <!-- Card Design Checkbox -->
                    <CheckBox x:Name="CardDesignCheckBox" Content="Card Design" IsChecked="True" Margin="0,2,0,4"/>

                    <!-- Landscape Option -->
                    <StackPanel Orientation="Horizontal" Margin="24,2,0,4">
                        <Border Width="18" Height="12" BorderBrush="Black" BorderThickness="1" Margin="0,0,12,0" Background="White"/>
                        <RadioButton x:Name="LandscapeRadio" Content="Landscape" IsChecked="True" GroupName="Orientation"/>
                    </StackPanel>

                    <!-- Portrait Option -->
                    <StackPanel Orientation="Horizontal" Margin="24,2,0,6">
                        <Border Width="12" Height="18" BorderBrush="Black" BorderThickness="1" Margin="3,0,15,0" Background="White"/>
                        <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="Orientation"/>
                    </StackPanel>

                    <!-- Allow multiple card designs -->
                    <CheckBox Content="Allow for more than one card design&#10;(data-driven card production)" 
                              Margin="24,2,0,6" FontSize="11"/>

                    <!-- Report Design Checkbox (Inside GroupBox) -->
                    <CheckBox Content="Report Design" Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Right Buttons Area -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,18,0,0">
            <Button Content="OK" Width="75" Height="23" Margin="0,0,0,6" IsDefault="True" Click="OK_Click"/>
            <Button Content="Cancel" Width="75" Height="23" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
